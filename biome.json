{
	"files": {
		"includes": ["**", "!node_modules", "!build", "!dist", "!package.json"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 140,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"types": "recommended"
		},
		"rules": {
			"a11y": "off",
			"complexity": {
				"noImportantStyles": "off"
			},
			"suspicious": {
				"useIterableCallbackReturn": {
					"level": "on",
					"options": {
						"checkForEach": false
					}
				}
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
